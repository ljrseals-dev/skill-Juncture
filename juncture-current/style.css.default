/* Juncture Studio — tape-machine front panel.
   Light putty = things you set. Dark glass = things that show signal. */
@font-face {
  font-family: "Archivo"; font-style: normal; font-weight: 100 900;
  font-stretch: 62% 125%; font-display: swap;
  src: url("vendor/fonts/archivo-latin-wdth-normal.woff2") format("woff2");
}
:root {
  --putty: #d3d6c7;      /* rail, page */
  --panel: #e4e5da;      /* working surface */
  --ink: #17201d;
  --ink-2: #4a554e;      /* secondary text, 6:1 on panel */
  --line: #aeb3a2;
  --teal: #0e5a57;       /* the one action colour */
  --teal-hi: #0a4543;
  --glass: #0e1513;      /* signal windows */
  --glass-2: #18221f;
  --glass-ink: #e9efe6;
  --glass-dim: #93a499;
  --amber: #f0a81c;      /* signal on glass only */
  --alert: #a8261b;
  --ui: "Archivo", "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --r: 2px;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; height: 100%; overflow: hidden;
  background: var(--panel); color: var(--ink);
  font: 400 14px/1.45 var(--ui); font-variant-numeric: tabular-nums;
}
:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
.on-glass :focus-visible, #display :focus-visible { outline-color: var(--amber); }

#app { display: grid; grid-template-columns: 236px 1fr; height: 100vh; }

/* rail */
#sidebar {
  background: var(--putty); border-right: 1px solid var(--line);
  display: flex; flex-direction: column; padding: 18px 16px; gap: 22px; overflow: hidden;
}
.brand-name { font: 800 22px/1 var(--ui); font-stretch: 78%; letter-spacing: -0.01em; }
.brand-sub { font-size: 12px; color: var(--ink-2); margin-top: 4px; }
.panel { display: flex; flex-direction: column; gap: 6px; min-height: 0; }
.panel-grow { flex: 1; overflow: hidden; }
.panel-title, .field label, .control label {
  font: 600 12px/1.2 var(--ui); font-stretch: 85%; color: var(--ink-2);
  display: flex; justify-content: space-between; align-items: center;
}

/* main column */
#main { display: grid; grid-template-rows: auto auto 1fr; overflow: hidden; }
#editor { padding: 18px 24px 14px; display: flex; flex-direction: column; gap: 12px; }

/* the display: where the signal lives */
#transport { padding: 0 24px 16px; }
#display {
  background: var(--glass); color: var(--glass-ink);
  border-radius: 4px; padding: 12px 14px 10px;
  box-shadow: inset 0 0 0 1px #000, inset 0 2px 10px #000;
}
.transport-bar { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
.btn-transport {
  width: 34px; height: 34px; border-radius: 50%; border: 0;
  background: var(--amber); color: var(--glass); font-size: 13px;
  display: grid; place-items: center; cursor: pointer;
}
.btn-transport:disabled { background: #3a4640; color: var(--glass-dim); cursor: default; }
.time { white-space: nowrap; font: 500 22px/1 var(--ui); font-stretch: 80%; letter-spacing: 0.02em; }
.readout { display: flex; gap: 22px; margin-left: 10px; }
.readout div { display: flex; flex-direction: column; font-size: 11px; color: var(--glass-dim); }
.readout b { font: 600 15px/1.3 var(--ui); font-stretch: 85%; color: var(--amber); }
.spacer { flex: 1; }
#waveform { height: 64px; border-radius: 2px; overflow: hidden; background: var(--glass-2); }
#display .btn-ghost { color: var(--glass-ink); border-color: #4b5a52; }
#display .btn-ghost:hover:not(:disabled) { background: var(--glass-2); border-color: var(--glass-dim); }

/* fields */
.field { display: flex; flex-direction: column; gap: 4px; }
.controls { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; }
.control { display: flex; flex-direction: column; gap: 4px; min-width: 90px; }
.seed-row { display: flex; gap: 6px; }
.seed-row input { width: 90px; }
input[type="text"], input[type="number"], textarea, select {
  background: #f1f2e9; color: var(--ink); border: 1px solid var(--line);
  border-radius: var(--r); padding: 7px 9px; font: 400 14px var(--ui);
}
textarea { resize: vertical; min-height: 80px; max-height: 200px; font: 12.5px/1.55 var(--mono); }
input:focus, textarea:focus, select:focus { border-color: var(--teal); }

/* buttons */
.btn-primary {
  background: var(--teal); color: #fff; border: 0; border-radius: var(--r);
  padding: 9px 22px; font: 700 14px var(--ui); margin-left: auto; cursor: pointer;
}
.btn-primary:hover:not(:disabled) { background: var(--teal-hi); }
.btn-primary:disabled { background: #7f9a97; cursor: default; }
.btn-ghost, .btn-mini {
  background: transparent; color: var(--ink); border: 1px solid var(--line);
  border-radius: var(--r); cursor: pointer; font: 500 13px var(--ui);
}
.btn-ghost { padding: 6px 14px; }
.btn-mini { padding: 4px 9px; }
.btn-ghost:hover:not(:disabled), .btn-mini:hover { background: #f1f2e9; border-color: var(--ink-2); }
.btn-ghost:disabled { opacity: 0.45; cursor: default; }

/* presets + history: plain lists, no cards */
.preset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 10px; }
.preset-grid button {
  background: none; border: 0; border-bottom: 1px solid var(--line); color: var(--ink);
  padding: 6px 0; text-align: left; font: 500 13px var(--ui); cursor: pointer;
}
.preset-grid button:hover { color: var(--teal); border-bottom-color: var(--teal); }
.history-list { overflow-y: auto; display: flex; flex-direction: column; }
.history-item { padding: 7px 0; border-bottom: 1px solid var(--line); cursor: pointer; }
.history-item:hover .hi-style { color: var(--teal); }
.history-item .hi-seed { color: var(--ink-2); font-size: 11px; }
.history-item .hi-style { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* progress */
#progress-wrap { margin-top: 2px; }
.progress-bar { height: 3px; background: var(--line); }
.progress-fill { height: 100%; width: 0; background: var(--teal); transition: width 0.25s ease; }
.progress-row { display: flex; justify-content: space-between; margin-top: 4px; }
.progress-label, .progress-eta { font-size: 11px; color: var(--ink-2); }

/* tabs */
#tabs { display: flex; flex-direction: column; overflow: hidden; border-top: 1px solid var(--line); }
.tabbar { display: flex; gap: 22px; padding: 0 24px; border-bottom: 1px solid var(--line); }
.tab {
  background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -1px;
  color: var(--ink-2); padding: 11px 0 8px; cursor: pointer; font: 600 14px var(--ui);
}
.tab:hover { color: var(--ink); }
.tab.active { color: var(--ink); border-bottom-color: var(--teal); }
.tabpane { display: none; overflow: auto; padding: 18px 24px; flex: 1; min-height: 0; }
.tabpane.active { display: block; }
.empty { color: var(--ink-2); font-size: 14px; padding: 22px 0; }

/* score: engraved paper */
.score-modes { display: flex; gap: 6px; margin-bottom: 12px; }
.score-modes .mode {
  background: none; border: 1px solid var(--line); border-radius: var(--r);
  color: var(--ink-2); padding: 4px 12px; cursor: pointer; font: 500 13px var(--ui);
}
.score-modes .mode.active { background: var(--ink); border-color: var(--ink); color: var(--panel); }
.score-view {
  background: #fbfbf6; border: 1px solid var(--line); border-radius: var(--r);
  padding: 14px; min-height: 160px; color: #000; overflow-x: auto;
}
.score-view .empty, .score-view pre.empty { color: var(--ink-2); padding: 12px 0; }
.score-view svg { max-width: 100%; height: auto; }
#abc-input { width: 100%; min-height: 140px; margin-bottom: 10px; }
.score-actions { display: flex; gap: 8px; margin-top: 14px; }
.score-actions .btn-primary { margin-left: 0; }

/* stems: ruled rows */
.stems-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 28px; }
.stem-card { padding: 12px 0; border-top: 1px solid var(--line); }
.stem-card h4 { margin: 0 0 6px; font: 600 13px var(--ui); font-stretch: 85%; color: var(--ink-2); }
.stem-card audio { width: 100%; }

/* EQ: signal window */
.eq {
  display: grid; grid-template-columns: repeat(10, 1fr); gap: 10px;
  background: var(--glass); color: var(--glass-ink);
  border-radius: 4px; padding: 18px; height: 260px;
  box-shadow: inset 0 0 0 1px #000, inset 0 2px 10px #000;
}
.eq-band { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.eq-band input[type="range"] { writing-mode: vertical-lr; direction: rtl; width: 4px; height: 160px; accent-color: var(--amber); }
.eq-band .freq { font-size: 11px; color: var(--glass-dim); }
.eq-band .gain { font-size: 11px; color: var(--amber); }
.eq-actions { display: flex; gap: 14px; align-items: center; margin-top: 12px; }
.eq-toggle { font-size: 13px; color: var(--ink-2); display: flex; align-items: center; gap: 6px; }

/* master */
.master-form { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-bottom: 8px; }
.master-form label { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); }
.master-form input[type="number"] { width: 74px; }
.master-note { font-size: 13px; color: var(--ink-2); margin: 4px 0 14px; max-width: 70ch; }
.master-result { background: var(--glass); color: var(--glass-ink); border-radius: 4px; padding: 14px; box-shadow: inset 0 0 0 1px #000, inset 0 2px 10px #000; }
.master-result .empty { color: var(--glass-dim); padding: 4px 0; }
.master-result audio { width: 100%; margin-bottom: 12px; }
.master-result table { border-collapse: collapse; font-size: 12.5px; }
.master-result td { padding: 3px 18px 3px 0; vertical-align: top; }
.master-result tr:not(.skip) td:last-child { color: var(--amber); }
.master-result .skip { color: var(--glass-dim); }

/* visualizer + log */
#vis-canvas { width: 100%; height: 420px; display: block; background: #000; border-radius: 4px; }
.vis-toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
.vis-label, .vis-toggle { font-size: 13px; color: var(--ink-2); }
#log {
  background: var(--glass); color: var(--glass-dim); border-radius: 4px; padding: 12px; margin: 0;
  font: 11.5px/1.6 var(--mono); white-space: pre-wrap; max-height: 100%; overflow: auto;
}

/* toast */
.toast {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: var(--ink); color: var(--panel); border-left: 4px solid var(--amber);
  padding: 10px 18px; border-radius: var(--r); font-size: 14px; z-index: 999;
}
.toast.err { border-left-color: #ff7a6b; }

@media (max-width: 820px) {
  html, body { overflow: auto; height: auto; }
  #app { grid-template-columns: 1fr; height: auto; }
  #sidebar { border-right: 0; border-bottom: 1px solid var(--line); }
  .panel-grow { max-height: 180px; }
  #main { display: block; }
  .stems-grid { grid-template-columns: 1fr; }
  .eq { grid-template-columns: repeat(5, 1fr); height: auto; }
  .readout { display: none; }
  .tabbar { overflow-x: auto; gap: 16px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }

/* markov chain composer */
.chain-form { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
.chain-title { font: 600 13px var(--ui); font-stretch: 85%; color: var(--ink-2); margin-right: 6px; }
.chain-form label { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink-2); }
.chain-form input[type="number"] { width: 68px; }

.map-pick { display: flex; justify-content: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.map-fig { margin: 0; background: #fbfaf7; border-radius: 8px; padding: 12px; overflow: auto; max-height: 70vh; }
.map-fig img { display: block; max-width: 100%; height: auto; margin: 0 auto; }

/* Compose tab */
.compose-card { border: 1px solid var(--line, #2a2a2e); border-radius: 6px; padding: 12px 14px; margin-bottom: 12px; }
.compose-card h3 { margin: 0 0 8px; font-size: 14px; }
.compose-card h3 small { color: var(--ink-2); font-weight: 400; margin-left: 8px; }
.compose-card .master-form input[type=text] { min-width: 18em; }
.mn-frame { width: 100%; height: 640px; border: 1px solid var(--line, #2a2a2e); border-radius: 4px; background: #080809; }
.compose-line { margin: 6px 0; font-size: 13px; }
.compose-card .master-result:empty { display: none; }
.compose-card a { color: var(--teal); }
/* Compose results sit on the dark glass panel: keep links and ghost buttons readable there. */
.compose-card .master-result a { color: var(--amber); }
.compose-card .master-result .btn-ghost { color: var(--glass-ink); border-color: var(--glass-dim); background: transparent; }
